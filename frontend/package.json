{
  "name": "dhcp-tool-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "NEXT_BUILD_DIR=.next-quality next typegen && tsc --noEmit",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../backend/config/openapi.json -o src/lib/api/schema.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:check": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.13.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
