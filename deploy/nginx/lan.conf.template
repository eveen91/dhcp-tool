# HTTP LAN/VPN mode explicitly requested by the operator.
log_format dhcp_safe '$request_method $status $request_time';
server {
    listen @HOST@:@PORT@;
    server_name @HOST@;
    allow 127.0.0.1;
    allow @CIDR@;
    deny all;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    send_timeout 15s;
    access_log /var/log/dhcp-tool/nginx-access.log dhcp_safe;
    error_log /dev/null;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control no-store always;

    location /api/v1/ {
        proxy_pass http://127.0.0.1:18000;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 35s;
        proxy_send_timeout 10s;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_hide_header Cache-Control;
        error_page 502 503 504 =503 @api_unavailable;
    }
    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"upstream_unavailable","message":"API jest chwilowo niedostępne. Sprawdź wynik przed ponowieniem zapisu.","fields":{}}}';
    }
    location /api/ { return 404; }
    location /_next/static/ {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $http_host;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_hide_header Cache-Control;
    }
}
