# Production: use a long random key generated outside the repository.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=dhcp.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://dhcp.example.org
POSTGRES_DB=dhcp_tool
POSTGRES_USER=dhcp_tool
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional trusted ISC DHCP parser: absolute executable path, never client supplied.
# DHCPD_PARSER_PATH=/usr/sbin/dhcpd

# Optional: root-published encrypted exports; never point at the key or original backups.
BACKUP_DOWNLOAD_DIR=/var/lib/dhcp-tool/backup-download
